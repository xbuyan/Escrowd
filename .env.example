# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/escrowd?sslmode=disable

# --- Auth ---
# Signs/verifies API JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=your-random-secret-here

# --- Discord bot ---
# Get from discord.com/developers
DISCORD_TOKEN=your-discord-token-here

# Discord user ID allowed to run !escrow resolve and !escrow backup
ESCROWD_ADMIN_DISCORD_ID=your-discord-user-id-here

# 32-byte hex key encrypting each deal's Stellar wallet secret before
# it's stored. Generate with: openssl rand -hex 32
ESCROWD_DB_KEY=your-32-byte-hex-key-here

# --- Stellar ---
STELLAR_NETWORK=testnet
# Secret key of the Stellar account that controls escrow claimable balances
STELLAR_MASTER_SECRET=your-stellar-secret-key-here

# --- Email (registration/verification) ---
# Optional — registration works without these; verification emails just
# fail to send (logged, not fatal) if unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# --- M-Pesa (Safaricom Daraja API) ---
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=your-mpesa-shortcode
MPESA_PASSKEY=your-mpesa-passkey

# --- Paystack ---
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# --- API server ---
# Grants admin role on the HTTP API to whichever account registers with
# this email
ESCROWD_ADMIN_EMAIL=admin@example.com
API_PORT=8080
FRONTEND_URL=http://localhost:5173
